# Salin ke .env lalu isi.
# API_ID & API_HASH: dari https://my.telegram.org (wajib diisi).
API_ID=              # dari https://my.telegram.org
API_HASH=            # dari https://my.telegram.org

# Token dari @BotFather
BOT_TOKEN=

# ID admin (boleh lebih dari satu, pisah spasi)
OWNER_ID=0

# Grup/channel database untuk backup statistik (id -100...). Kosongkan / 0 = nonaktif.
LOG_GROUP=0

# Detik sebelum game auto-berakhir bila tak ada jawaban benar (default 600 = 10 menit)
GAME_TIMEOUT=600
